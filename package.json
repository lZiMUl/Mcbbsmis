    }
  ],
  "maintainers": [
    {
      "name": "lZiMUl",
      "email": "lZiMUl@lzimul.com",
      "url": "https://www.lzimul.com"
    }
  ],
  "homepage": "https://projects.lzimul.com/mcbbsmis",
  "main": "./build/index.js",
  "types": "./lib/index.d.ts",
  "typings": "./lib/index.d.ts",
  "license": "MIT",
  "scripts": {
    "init": "node . && npm run start",
    "start": "node .",
    "config": "node . --configure-panel && npm run start",
    "lint": "npx eslint --fix",
    "build": "npm run lint && npm run build:css && npm run build:client && npm run build:server",
    "build:css": "npx sass ./src/client/scss:public/css",
    "build:client": "npx tsc -p ./tsconfig.client.json",
    "build:server": "npx tsc -p ./tsconfig.server.json",
    "typedoc:client": "npx typedoc --options ./typedoc.client.json",
    "typedoc:server": "npx typedoc --options ./typedoc.server.json",
    "test": "echo Done",
    "dev": "npm run build && npm run start",
    "clean": "node ./scripts/clean.mjs",
    "install:china": "npm install --legacy-peer-deps --register=https://registry.npmmirror.com",
    "update:china": "npm update --legacy-peer-deps --register=https://registry.npmmirror.com"
  },
  "exports": {
    ".": {
      "default": {
        "default": "./build/index.js",
        "require": "./build/index.js",
        "types": "./lib/index.d.ts"
      }
    }
  },
  "files": [
    "./build/",
    "./data/",
    "./lang",
    "./lib/",
    "./proto",
    "./public",
    "./LICENSE",
    "./CHANGELOG.md",
    "./README.md",
    "./SECURITY.md"
  ],
  "keywords": [
    "lZiMUl",
    "bilibili",
    "bililive",
    "minecraft",
    "danmaku",
    "message",
    "gift"
  ],
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@inquirer/prompts": "^8.8.0",
    "@koa/bodyparser": "^6.1.0",
    "@koa/router": "^15.7.1",
    "axios": "^1.21.1",
    "bili-sender": "^1.1.2",
    "commander": "^15.1.0",
    "figlet": "^1.12.0",
    "gradient-string": "^3.0.0",
    "koa": "^3.3.0",
    "koa-static": "^5.0.0",
    "log4js": "^6.9.1",
    "open": "^11.0.4",
    "protobufjs": "^8.8.1",
    "qrcode-terminal": "^0.12.0",
    "semver": "^7.8.6",
    "tiny-bilibili-ws": "1.0.2",
    "toml": "^5.0.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@types/koa": "^3.0.3",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "repository": {
    "type": "git",
